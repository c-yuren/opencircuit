{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "typeId": {
            "type": "string",
            "pattern": "^(official|custom):[A-Za-z0-9_-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "category": {
            "enum": [
              "controller",
              "sensor",
              "output",
              "power",
              "passive",
              "connector",
              "consumable"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "moduleVersion": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "physical": {
            "type": "boolean"
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "input",
                    "output",
                    "bidirectional",
                    "passive",
                    "power",
                    "ground"
                  ]
                },
                "interfaces": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": {
                  "type": "boolean"
                },
                "voltage": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "name",
                "direction",
                "interfaces",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "price": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "high": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "packSize": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "basis": {
                    "enum": [
                      "pack",
                      "piece"
                    ]
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "demo": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "low",
                  "high",
                  "currency",
                  "packSize",
                  "basis",
                  "date",
                  "source",
                  "demo"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "driver": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "compileProfile": {
            "type": "string",
            "minLength": 1
          },
          "simulationAdapter": {
            "type": "string",
            "minLength": 1
          },
          "fixedAddress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "visual": {
            "type": "object",
            "properties": {
              "preset": {
                "enum": [
                  "uno",
                  "esp32",
                  "led",
                  "resistor",
                  "oled",
                  "dht",
                  "button",
                  "mpu",
                  "buzzer",
                  "breadboard",
                  "jumper",
                  "supply",
                  "capacitor",
                  "header",
                  "ground",
                  "generic"
                ]
              },
              "image": {
                "type": "string",
                "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$",
                "maxLength": 2800000
              },
              "width": {
                "type": "number",
                "minimum": 40,
                "maximum": 600
              },
              "height": {
                "type": "number",
                "minimum": 40,
                "maximum": 600
              },
              "pinPositions": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "side": {
                      "enum": [
                        "left",
                        "right",
                        "top",
                        "bottom"
                      ]
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "width",
              "height",
              "pinPositions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "typeId",
          "version",
          "category",
          "name",
          "model",
          "moduleVersion",
          "unit",
          "source",
          "physical",
          "pins",
          "parameters",
          "price"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "definitions"
  ],
  "additionalProperties": false
}
