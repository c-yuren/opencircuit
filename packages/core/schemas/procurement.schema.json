{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "budget": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "reserve": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "missingMaterials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "usable": {
            "type": "boolean"
          }
        },
        "required": [
          "quantity",
          "usable"
        ],
        "additionalProperties": false
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "low": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "high": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "packSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "basis": {
            "enum": [
              "pack",
              "piece"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "demo": {
            "type": "boolean"
          }
        },
        "required": [
          "low",
          "high",
          "currency",
          "packSize",
          "basis",
          "date",
          "source",
          "demo"
        ],
        "additionalProperties": false
      }
    },
    "manual": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "typeId": {
            "type": "string",
            "minLength": 1
          },
          "definitionVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "instanceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "typeId",
          "definitionVersion",
          "parameters",
          "quantity",
          "instanceRefs"
        ],
        "additionalProperties": false
      }
    },
    "locked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "substitutable": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "currency",
    "budget",
    "reserve",
    "missingMaterials",
    "inventory",
    "overrides",
    "manual",
    "locked",
    "requiredFeatures",
    "substitutable"
  ],
  "additionalProperties": false
}
